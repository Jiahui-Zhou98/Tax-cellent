# Tax-cellent Backend Configuration
# Copy this file to .env and fill in the values you need.
# Only the providers you want to use require API keys.
# Ollama (local) works out of the box with no API key.

# ─── Ollama (default — local, free, private) ────────────────────────────────
# Ollama must be running locally. Install: https://ollama.com
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Default model used when no model is specified in the request
# OPENAI_MODEL=gpt-4o

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Default model used when no model is specified in the request
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# Default model used when no model is specified in the request
# GEMINI_MODEL=gemini-2.0-flash

# ─── Server settings ─────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated). Include your frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload and session storage directories
# UPLOAD_DIR=/tmp/taxdebate_uploads
# SESSION_DIR=/tmp/taxdebate_sessions
